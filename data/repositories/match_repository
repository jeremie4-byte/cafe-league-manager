def get_all_matches_by_time(schedule_match_time: datetime):

    """We first establish a db connection"""
    db_connection = get_connection()

    """We then create our match_cursor object that will retrieve the data we need"""
    match_cursor = db_connection.cursor()

    """We then try to get all matches with the same """
    try:
        match_cursor.execute(
            """
            SELECT match_id, event_id, schedule_match_time
            FROM Cafe_Match
            WHERE schedule_match_time = ?
            """,
            (schedule_match_time.isoformat(),) # value is called here because we need a datetime format
        )

        same_time_entries = match_cursor.fetchall()

        """We create an empty list to append all matches with the same time"""
        same_time_events = []

        if same_time_entries is not None:
            for match in same_time_entries:
                match_entry = Match(
                    match["match_id"],
                    match["event_id"],
                    datetime.fromisoformat(match["schedule_match_time"])
                )
                same_time_events.append(match_entry)
            return same_time_events     

        else:
            raise ValueError(f"No matches found during the time: {same_time_entries}") 

    finally:
        db_connection.close()  
