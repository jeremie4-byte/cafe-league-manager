from data.db import get_connection
from datetime import datetime
from domains.match import Match

"""Function to save match entries to db"""
def save_match_entry(match_entry: Match):

    """We first establish the db connection"""
    db_connection = get_connection()

    """We create the match_cursor to navigate and manipulate the match table"""
    match_cursor = db_connection.cursor()

    """We insert the object using the .execute() method and the match_cursor"""

    """
    We try to do an INSERT STATEMENT WITH ALL SQL ATTRIBUTES.
    Then we add Values as (?, ?, ?, ?) since we are working with sqlite
    We then give the proper domain class fields to be entered
    """

    try:
        match_cursor.execute("""
        INSERT INTO Cafe_Match (match_id, event_id, schedule_match_time)
        VALUES (?, ?, ?)
        """,
        (
            match_entry.match_id,
            match_entry.event_id,
            match_entry.schedule_match_time.isoformat()
        )
    )
        #We use the lastrowid functionality on the cursor to obtain the last generated ID from our match entry 
        new_match = match_cursor.lastrowid

        # We save the changes to the db
        db_connection.commit()
        print("New match entry saved succesfully!")
        return new_match
    
    except Exception as e:
        #should there be any error we rollback and dont commit to db
        db_connection.rollback()
        print(f"Failed to insert match: {e}")
        raise 

    finally:
        db_connection.close()

def get_match_by_id (match_id: int):

    """We first establish a db connection"""
    db_connection = get_connection()

    """We create the match_cursor to naviguate and manipulate the match table"""
    match_cursor = db_connection.cursor()

    """ 
    We find the matching data row with the ID.
    We must first use an SQL SELECT STATEMENT and add a 
    conditionnal WHERE clause
    """
    try:
        match_cursor.execute(
            """
            SELECT match_id, event_id, schedule_match_time
            FROM Cafe_Match
            WHERE match_id = ?
            """,
            (match_id,)
        )
        #We fetch the one matching row
        matching_row = match_cursor.fetchone()

        if matching_row is not None:
            matching_entry = Match(
               matching_row["match_id"],
               matching_row["event_id"],
               datetime.fromisoformat(matching_row["schedule_match_time"])
           ) 
            return matching_entry
    
        else:
           raise ValueError(f"No match found with {match_id}")
        
    finally:
        db_connection.close()

def delete_match_by_id (match_id: int):

    """We first establish a db connection"""
    db_connection = get_connection()

    """We create the match_cursor to naviguate and manipulate the match table"""
    match_cursor = db_connection.cursor()

    """ We try to delete the player entry using the ID"""
    try: 
        match_cursor.execute(
            """
            DELETE FROM Cafe_Match
            WHERE match_id = ?
            """,
            (match_id,)
        )

        """Row count allows us to see all entries with the inputed ID"""
        row_affected = match_cursor.rowcount

        if row_affected == 0:
            raise ValueError(f"No match found with match id {match_id}")
        
        else:
            db_connection.commit()
            print(f"Match deleted succesfully!")
            return row_affected

    # We finish by closing the connection 
    finally:
        db_connection.close()

def get_all_matches():

    """We first establish the db_connection"""
    db_connection = get_connection()

    """We create the match_cursor to naviguate and manipulate the match table"""
    match_cursor = db_connection.cursor()

    """
    We now SELECT all match entries to display
    all match objects that have been created
    """

    try:
        match_cursor.execute(
            """
            SELECT match_id, event_id, schedule_match_time
            FROM Cafe_Match
            """
        )

        """We assign a new variable (match_repository) where the cursor fetches all match entries"""
        match_repository = match_cursor.fetchall()

        """We create an empty list to append all match entries"""
        match_list = []

        for match_row in match_repository:
            match_entry = Match(
                match_row["match_id"],
                match_row["event_id"],
                datetime.fromisoformat(match_row["schedule_match_time"])
            )
            match_list.append(match_entry)

        #We return all of the appended entries into the list
        return match_list
    
    #close the db_connection when all the operations have been realised.
    finally:
        db_connection.close()

def update_match_attributes(match_id: int, event_id: None, schedule_match_time: None):

    """We first establish a db connection"""
    db_connection = get_connection()

    """We create the match_cursor to naviguate and manipulate the match table"""
    match_cursor = db_connection.cursor()

    """We build an empty list to which we will append the original and updated values"""
    values= []

    """We build a second list to append all updated field entries"""
    updated_field_entries = []

    if event_id is not None:
        updated_field_entries.append("event_id = ?")
        values.append(event_id)

    if schedule_match_time is not None: 
        updated_field_entries.append("schedule_match_time = ?")
        values.append(schedule_match_time.isoformat())

        """We verify after our 2 conditionnals that the values list actually have values in them otherwise we raise an error"""
    if len(values) == 0:
        raise ValueError(f"No fields were updated for player with match ID {match_id}")
    
    """We join all updated_field_entries list elements as a single string to avoid hardcoding the SET clause"""
    new_fields = ", ".join(updated_field_entries)

    """
        We append match_id at the end of values so that our WHERE condition 
        to identify the player whose entries need updates work.
    """
    values.append(match_id)

    try:
        match_cursor.execute(
            f"""
            UPDATE Cafe_Match
            SET {new_fields}
            WHERE match_id = ?
            """, tuple(values) # Convert values list to a tuple for best practice and to make updated values immutable
        )

        """rowcount allows us to see the number of rows affected by the changes"""
        updated_match = match_cursor.rowcount

        """If 0 updated_match were affected (or invalid match_id), nothing was updated on our match entry"""
        if updated_match == 0:
            raise ValueError(f"Match with id {match_id} had no fields updated")
        
        #If updated_match was updated we commit the changes to db_connection
        else:
            db_connection.commit()
            print(f"Match with ID {match_id} had its attributes succesfully updated!")
            return updated_match

    # If there is any exceptions that occur during the commit, we raise an exception and perform a rollback 
    except Exception as e:
        db_connection.rollback()
        print(f"Failed to update match because of error: {e}")
        raise
    
    finally:
        db_connection.close()

